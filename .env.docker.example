# Copy to .env before `docker compose up`.
APP_NAME=Mnemon
APP_ENV=production
# Leave this line COMMENTED OUT to have the entrypoint generate a key and
# persist it in the storage volume on first boot. Uncomment and set it to pin
# the key yourself (e.g. to migrate an existing deployment's key onto this host).
#
# It is commented rather than left blank on purpose. Compose passes a blank
# `APP_KEY=` into the container as a variable that is *set* to the empty string,
# and Laravel's Dotenv will not override an already-set variable — so a blank
# line here silently shadows the generated key for every `docker compose exec`,
# and `php artisan tinker` fails with "No application encryption key has been
# specified" even though the app itself is running fine.
# APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080

# Set to a hostname you control to get automatic HTTPS from Let's Encrypt.
# Leave blank to serve plain HTTP on localhost:8080 for local trial.
# To run behind your own TLS-terminating reverse proxy instead, leave DOMAIN
# blank and set TRUSTED_PROXIES to the proxy's address or CIDR. It must match
# the address the app sees the proxy connect from; check it (e.g. in the access
# log), since on a typical bridge network it is the Docker gateway, not
# 127.0.0.1. Setting APP_URL to the public https:// address is also sensible.
# Not tested end to end; see the README.
DOMAIN=
# TRUSTED_PROXIES=

# Setting DOMAIN above REQUIRES both of these to be public binds — Let's
# Encrypt validates over port 80 and serves over 443. Leave them at their
# defaults for a local trial; a DOMAIN with loopback binds will fail
# certificate issuance.
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443

LOG_CHANNEL=stderr
LOG_LEVEL=info

# APP_TIMEZONE is what the scheduler actually obeys: every command in
# routes/console.php declares config('app.timezone'), so the early-morning
# maintenance runs early in THIS timezone rather than at a hard-coded UTC
# offset. Change it if you want maintenance to run in your local early morning.
APP_TIMEZONE=UTC

# TZ only sets the container's OS clock, which affects shell tools and
# non-PHP log timestamps. Laravel overrides PHP's timezone from APP_TIMEZONE
# regardless, so setting TZ alone will NOT move the schedule. Keep it matching
# APP_TIMEZONE so container logs and application times agree.
TZ=UTC

# Contact-form submissions on the landing page are always recorded in the
# database (ContactSubmission). Mail is written to the log by default — set
# a real mailer (e.g. MAIL_MAILER=resend, resend/resend-laravel is already a
# dependency) plus MAIL_FROM_ADDRESS, RESEND_API_KEY, and MNEMON_CONTACT_TO
# below to additionally get an email notification.
MAIL_MAILER=log

# Required if you set MAIL_MAILER=resend (or any real mailer): config/mail.php
# defaults the from-address to hello@example.com, which Resend and most
# providers reject as an unverified sender.
MAIL_FROM_ADDRESS=

# Required if you set MAIL_MAILER=resend. Get one from resend.com.
RESEND_API_KEY=

# Blank means the contact form only stores submissions — no email is sent.
# Set this to an address you own to also get notified.
MNEMON_CONTACT_TO=

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mnemon
DB_USERNAME=mnemon
# Fixed the moment the `pgdata` volume is first initialised — Postgres only
# reads this on an EMPTY data directory. Changing it later and restarting
# does NOT change the role's password: the app crash-loops with "password
# authentication failed for user "mnemon"" while the db healthcheck
# (pg_isready, which performs no authentication) stays green. Change it
# before first boot, not after. To change it later: either run
# `ALTER ROLE mnemon WITH PASSWORD '...'` inside the db container and update
# this value to match, or `docker compose down -v` to start over (destroys
# all data). See docs/USERGUIDE.md.
DB_PASSWORD=change-me-before-you-deploy

# No embeddings by default: works with no account and no spend. Set to
# "openai" and supply OPENAI_API_KEY for semantic search, or use "voyage"
# (VOYAGE_API_KEY), "gemini" (GEMINI_API_KEY) or "openai-compatible"
# (MNEMON_EMBEDDING_BASE_URL, _MODEL, _DIMENSIONS); see the README.
MNEMON_EMBEDDING_DRIVER=none
OPENAI_API_KEY=

# The digest review queue (Admin -> Review Queue). off files confident
# proposals and drops the rest, as before; low holds the below-floor ones for
# review instead; all holds every proposal until you approve it.
MNEMON_DIGEST_REVIEW=off

# Document uploads (Admin -> Documents, POST /api/documents, document_add).
# Originals are kept on this disk under documents/. MAX_MB is per file; PHP's
# upload_max_filesize and post_max_size must allow it too. MCP_MAX_MB is
# document_add's limit, whose file travels base64 inside a JSON request.
# MNEMON_DOCUMENT_DISK=local
# MNEMON_DOCUMENT_MAX_MB=25
# MNEMON_DOCUMENT_MCP_MAX_MB=10
# MNEMON_DOCUMENT_ROOM=documents
# MNEMON_DOCUMENT_CHUNK_CHARS=4000
# MNEMON_DOCUMENT_MAX_CHUNKS=200
# MNEMON_DOCUMENT_TIME_LIMIT=300
# Images (png, jpg, webp) are described by the digest provider's vision model,
# one paid call each. false stores them without text. VISION_MODEL picks
# another model of the same provider; it must read images.
# MNEMON_DOCUMENT_VISION=true
# MNEMON_DOCUMENT_VISION_MODEL=

# Session digests (automatic capture) run on OpenAI unless another provider
# is chosen: MNEMON_DIGEST_DRIVER=anthropic with ANTHROPIC_API_KEY, or
# openai-compatible with MNEMON_DIGEST_BASE_URL and MNEMON_DIGEST_MODEL. A
# model marked for digests in the admin panel overrides this.
# MNEMON_DIGEST_DRIVER=openai
# ANTHROPIC_API_KEY=

# Nothing dispatches jobs today. sync means a future dispatch() fails loudly
# rather than rotting unclaimed in the jobs table.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
CACHE_STORE=database
